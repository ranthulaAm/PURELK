rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for admin access
    function isAuthenticated() {
      return request.auth != null;
    }

    function isHardcodedOwner() {
      return isAuthenticated() && (request.auth.token.email == 'ranthulaicloud112@gmail.com' || request.auth.token.email == 'dineththeekshana67@gmail.com');
    }

    function isAdmin() {
      // Anyone you add to Firebase Auth is considered an admin since there is no public signup.
      return isAuthenticated();
    }

    function isOwner() {
      return isAuthenticated();
    }

    match /site_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contact_submissions/{submissionId} {
      // Anyone can submit a contact form
      allow create: if true;
      // Only admins can read, update (mark as read), or delete
      allow read, update, delete: if isAdmin();
    }

    match /admin_users/{userId} {
      // Admins can read the list of admins
      allow read: if isAdmin();
      // Only owners can add/remove/edit other admins
      allow create, update, delete: if isOwner();
    }

    match /page_views/{viewId} {
      // Anyone can log a page view
      allow create: if true;
      // Only admins can read analytics or delete records
      allow read, delete: if isAdmin();
      allow update: if false; // Views should not be updated
    }
  }
}
